# The public host (no scheme); the tunnel routes it here.
WIRES_GATEWAY_HOST=wires.positivesum.ai
# A Google OAuth client of type "Web application", with the authorized
# redirect URI https://<WIRES_GATEWAY_HOST>/oauth/callback. The admin adds
# this client id to the audiences the signed policy accepts from Google
# (`wires issuer set … --audience <this id>`); a host whose host.json narrows
# identity.issuers[].audiences must list it there too.
WIRES_GATEWAY_CLIENT_ID=
WIRES_GATEWAY_CLIENT_SECRET=
# `tofu output -raw wires_tunnel_token` in positivesum/infra stacks/dns.
WIRES_TUNNEL_TOKEN=
