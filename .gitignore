user.bazelrc
.env
*.DS_Store

# Symlinks created by Bazel into the output tree
/bazel-*


node_modules/


*.venv/


vendor/bundle/
/target/

# Claude Code local state (worktrees, scratch keystores with seeds/tokens); only the shared settings are tracked
.claude/*
!.claude/settings.json
