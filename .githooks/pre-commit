#!/usr/bin/env bash
# Refuse a commit whose staged Rust is not rustfmt-clean. Enable with
# `make hooks` (git config core.hooksPath .githooks).
set -euo pipefail

files=()
while IFS= read -r -d '' f; do files+=("$f"); done < <(git diff --cached --diff-filter=AM --name-only -z -- '*.rs')
[ "${#files[@]}" -eq 0 ] && exit 0

if ! rustfmt --edition 2024 --check "${files[@]}" >/dev/null; then
	echo "pre-commit: staged Rust is not formatted; run \`cargo fmt\` and re-stage:" >&2
	rustfmt --edition 2024 --check -l "${files[@]}" >&2 || true
	exit 1
fi
