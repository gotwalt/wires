{
  "version": 2,
  "identity": {
    "issuers": [
      { "issuer": "__ISSUER__", "audiences": ["__CLIENT_ID__"] }
    ]
  },
  "services": {
    "deploy": {
      "command": ["__CI__", "deploy"],
      "env": { "CI_JOBS": "__JOBS__", "CI_JOB_SECS": "__JOB_SECS__", "CI_WIRES": "__WIRES__" }
    },
    "status": {
      "command": ["__CI__", "status"],
      "env": { "CI_JOBS": "__JOBS__", "CI_JOB_SECS": "__JOB_SECS__", "CI_WIRES": "__WIRES__" }
    },
    "logs": {
      "command": ["__CI__", "logs"],
      "env": { "CI_JOBS": "__JOBS__", "CI_JOB_SECS": "__JOB_SECS__", "CI_WIRES": "__WIRES__" }
    }
  },
  "push": { "allow": ["analyst"] }
}
