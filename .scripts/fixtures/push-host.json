{
  "version": 2,
  "identity": {
    "issuers": [
      { "issuer": "__ISSUER__", "audiences": ["__CLIENT_ID__"] }
    ]
  },
  "services": {
    "deploy": { "command": ["__CI__", "deploy"] },
    "status": { "command": ["__CI__", "status"] },
    "logs": { "command": ["__CI__", "logs"] }
  },
  "push": { "allow": ["analyst"] }
}
